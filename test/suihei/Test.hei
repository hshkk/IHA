-- I - IV - V - I
m = 1|4 h ^ 3 ^ 5 > 4 q ^ 6 ^ 1|5| > 5 ^ 7 ^ 2|5| > 1 h ^ 3 ^ 5

-- Outputs m to the console in relative values.
-- "1|4| h ^ 3|4| h ^ 5|4| h > 4|4| q ^ 6|4| q ^ 1|5| q > 5|4| q ^ 7|4| q ^ 2|5| q > 1|4| h ^ 3|4| h ^ 5|4| h"
out m

-- Outputs m to the console, absolutizing with respect to C major.
-- "C4 h ^ E4 h ^ G4 h > F4 q ^ A4 q ^ C5 q > G4 q ^ B4 q ^ D5 q > C4 h ^ E4 h ^ G4 h"
out m in I

-- I - IV/bIII - V/bIII - I
m' = 1|4 h ^ 3 ^ 5 > 6b|3| q ^ 1 ^ 3b > 7b|3| ^ 2 ^ 4 > 1 h ^ 3 ^ 5

-- Outputs m' to the console, absolutizing with respect to C major.
-- "C4 h ^ E4 h ^ G4 h > Ab3 q ^ C4 q ^ E4 q > Bb3 q ^ D4 q ^ F4 q > C4 h ^ E4 h ^ G4 h"
out m' in I

-- Outputs m' to the console, absolutizing with respect to Eb major. Note the changes in octaviation.
-- "Eb4 h ^ G4 h ^ Bb4 h > Cb4 q ^ Eb4 q ^ Gb4 q > Db4 q ^ F4 q ^ Ab4 q > Eb4 h ^ G4 h ^ Bb4 h"
out m' in bIII

p = infer m

-- Outputs p to the console, absolutizing with respect to F# major.
-- "F# h > B q > C# q > F# h"
out p in #IV

p' = infer m'

-- Outputs the serial composition of p and p' to the console in relative values.
-- "I h > IV q > V q > I h > I h > IV/bIII q > V/bIII q > I h"
out (p > p')

-- Outputs the serial composition of p and p', absolutizing with respect to D major.
-- "D h > G q > A q > D h > D h > Bb q > C q > D h"
out (p > p') in II

-- I - IV - V7 - I
m'' = 1|4 h ^ 3 ^ 5 > 4 q ^ 6 ^ 1|5| > 5 ^ 7 ^ 2|5 ^ 4 > 1|4 h ^ 3 ^ 5

p'' = infer m''

-- Outputs p'' to the console, absolutizing with respect to F# major.
-- "F# h > B q > C#7 q > F# h"
out p'' in #IV